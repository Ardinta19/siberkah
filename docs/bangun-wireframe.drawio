                </mxCell>
                <mxCell id="s1" parent="1" style="html=1;fillColor=#D9D9D9;strokeColor=#666;fontSize=10;align=left;spacingLeft=10;" value="Bilah atas atau bar menu" vertex="1">
                    <mxGeometry height="38" width="280" x="40" y="96" as="geometry"/>
                </mxCell>
                <mxCell id="s2" parent="1" style="html=1;fillColor=#fff;strokeColor=#777;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" value="Kotak isi: teks, kartu, ringkasan" vertex="1">
                    <mxGeometry height="38" width="280" x="40" y="142" as="geometry"/>
                </mxCell>
                <mxCell id="s3" parent="1" style="html=1;fillColor=#EEE;strokeColor=#999;dashed=1;fontSize=10;fontColor=#777;whiteSpace=wrap;" value="Foto atau gambar (tempat foto)" vertex="1">
                    <mxGeometry height="38" width="280" x="40" y="188" as="geometry"/>
                </mxCell>
                <mxCell id="s4" parent="1" style="html=1;rounded=1;fillColor=#fff;strokeColor=#888;fontSize=10;fontColor=#777;align=left;spacingLeft=10;whiteSpace=wrap;" value="Kolom isian" vertex="1">
                    <mxGeometry height="38" width="280" x="40" y="234" as="geometry"/>
                </mxCell>
                <mxCell id="s5" parent="1" style="html=1;rounded=1;fillColor=#444;strokeColor=#222;fontColor=#fff;fontStyle=1;fontSize=11;whiteSpace=wrap;" value="Aksi utama, satu per layar" vertex="1">
                    <mxGeometry height="38" width="280" x="40" y="280" as="geometry"/>
                </mxCell>
                <mxCell id="s6" parent="1" style="html=1;rounded=1;fillColor=#fff;strokeColor=#444;fontSize=10;whiteSpace=wrap;" value="Aksi kedua" vertex="1">
                    <mxGeometry height="38" width="280" x="40" y="326" as="geometry"/>
                </mxCell>
                <mxCell id="s7" parent="1" style="html=1;shape=note;size=8;fillColor=#FFF2A8;strokeColor=#BFA800;fontSize=9;align=left;whiteSpace=wrap;spacing=6;verticalAlign=top;" value="Catatan perilaku (kuning)" vertex="1">
                    <mxGeometry height="38" width="280" x="40" y="372" as="geometry"/>
                </mxCell>
                <mxCell id="bp" parent="1" style="html=1;fillColor=#fff;strokeColor=#777;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" value="UKURAN LAYAR YANG DIGAMBAR&#xa;&#xa;Ponsel 360 px: rancangan dasar, tanpa awalan.&#xa;md 768 px: dua kolom (tablet, tidak digambar terpisah).&#xa;lg 1024 px: gambar laptop, menu atas, panel berdampingan.&#xa;xl 1280 px: hanya membatasi lebar isi sekitar 1200 px.&#xa;&#xa;Urutan kerja: ponsel dahulu, laptop sebagai peningkatan.&#xa;Margin sisi ponsel 12 px, jarak antarkotak 8 sampai 12 px.&#xa;Tinggi tombol dan kolom isian minimal 44 px.&#xa;Huruf isi 16 px." vertex="1">
                    <mxGeometry height="230" width="400" x="340" y="66" as="geometry"/>
                </mxCell>
                <mxCell id="rd" parent="1" style="html=1;fillColor=#fff;strokeColor=#777;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" value="CARA MEMBACA&#xa;&#xa;- Tiap halaman: kiri ponsel, tengah laptop, kanan catatan kuning.&#xa;- Wireframe sengaja abu-abu. Warna dan huruf ditentukan di tahap design token.&#xa;- Teks dan angka contoh hanya ilustrasi, bukan harga atau nama resmi.&#xa;- Kode layar: K pelanggan, S staf, A admin, O owner.&#xa;- BR, T, UC, NFR mengacu ke SRS SIBERKAH." vertex="1">
                    <mxGeometry height="170" width="400" x="340" y="308" as="geometry"/>
                </mxCell>
                <mxCell id="ls" parent="1" style="html=1;fillColor=#fff;strokeColor=#777;fontSize=10;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;" value="DAFTAR LAYAR PELANGGAN&#xa;&#xa;K-01 Katalog (bagian 1)&#xa;K-02 Detail produk (bagian 1)&#xa;K-03 Masuk dan kode OTP (bagian 1)&#xa;K-04 Isi pesanan (bagian 1)&#xa;K-05 Pembayaran (bagian 1)&#xa;K-06 Lacak pesanan (bagian 1)&#xa;K-07 Pesanan saya (bagian 2)&#xa;K-08 Profil dan hapus akun (bagian 2)&#xa;K-09 Kebijakan privasi (bagian 2)&#xa;K-10 Detail produk custom (bagian 2)&#xa;&#xa;Bagian 2: K-07 sampai K-10, keadaan khusus, S-00 sampai S-04.&#xa;Bagian 3: A-01 sampai A-03, O-01 sampai O-04, peta navigasi semua peran." vertex="1">
                    <mxGeometry height="330" width="400" x="760" y="66" as="geometry"/>
                </mxCell>
                <mxCell id="ky" parent="1" style="html=1;shape=note;size=8;fillColor=#FFF2A8;strokeColor=#BFA800;fontSize=9;align=left;whiteSpace=wrap;spacing=6;verticalAlign=top;" value="KEPUTUSAN SEMENTARA (ubah bila jawabanmu berbeda)&#xa;&#xa;- Pelanggan dirancang untuk ponsel dan laptop sekaligus.&#xa;- Kalender memakai bawaan perangkat.&#xa;- Huruf isi 16 px, staf boleh 17 sampai 18 px.&#xa;- Konfirmasi bayar lewat tombol WhatsApp, bukan unggah bukti.&#xa;- Staf produksi dan kurir satu peran.&#xa;- Papan bunga hanya diantar atau boleh diambil: belum diputuskan, K-04 menampilkan kedua pilihan." vertex="1">
                    <mxGeometry height="230" width="300" x="1180" y="66" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
