                    <mxGeometry height="300" width="300" x="1530" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="y2" parent="1" style="html=1;shape=note;size=8;fillColor=#FFF2A8;strokeColor=#BFA800;fontSize=9;align=left;whiteSpace=wrap;spacing=6;verticalAlign=top;" value="SAAT TOMBOL DITEKAN&#xa;Satu transaksi basis data: kunci unit, tulis hari_reservasi, buat pesanan. Jika tanggal baru saja diambil orang lain, tampil Tanggal ini baru saja terisi dan pengguna kembali ke K-02 dengan saran tanggal lain (BR-03).&#xa;PONSEL&#xa;Di ponsel, total harga dan tombol Buat pesanan melekat di dasar layar.&#xa;LAPTOP&#xa;Formulir di kiri, ringkasan biaya di kanan ikut menempel.&#xa;Papan bunga: pilihan Ambil di toko disembunyikan jika diputuskan hanya antar." vertex="1">
